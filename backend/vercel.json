{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "30 7 * * *"
    },
    {
      "path": "/api/cron/quad",
      "schedule": "5 8 * * 1-5"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 300
    }
  }
}
